# Site identity is fixed in src/config/brands.ts for this repository.
SITE_URL=https://skyi.co.za
# Local review only: place origin overrides in ignored .env.development.local.
# SKYRIDERS_SITE_URL=http://localhost:3000
# SKYI_SITE_URL=http://localhost:3006
# Do not package development env files. Cross-brand handoffs open /.
# NEXT_PUBLIC_SKYRIDERS_URL=https://ropeaccess.co.za/
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# Server-only Afrihost SMTP. Get this mailbox's exact host from ClientZone/cPanel.
# Add values to ignored .env.local or the host environment; never NEXT_PUBLIC_.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# An authenticated ropeaccess.co.za sender authorised by the mail server.
SMTP_FROM=info@ropeaccess.co.za
# Recipients are fixed: info@ropeaccess.co.za and reception@ropeaccess.co.za.
